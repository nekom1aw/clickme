# PostgreSQL dari compose.postgres.yaml (container clickme-postgres).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=clickme
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DATABASE=clickme

# WAHA runs separately from Next.js. Use the host port exposed by WAHA.
WAHA_API_URL=http://127.0.0.1:3002
WAHA_API_KEY=replace-with-your-waha-api-key
WAHA_SESSION=default
WAHA_DEFAULT_COUNTRY_CODE=62

# Required: /api/webhooks/waha rejects every request when this is unset.
WAHA_WEBHOOK_SECRET=replace-with-a-random-secret

# Full WhatsApp group chat ID. Example: 120363123456789012@g.us
WAHA_TASK_GROUP_ID=

# Public application origin used in monitoring links sent to WhatsApp.
APP_URL=http://localhost:3002

# SMTP untuk notifikasi perubahan email akun.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Clickme <no-reply@example.com>
OTP_SECRET=replace-with-a-long-random-secret

# MinIO S3 API (port 9000), bukan MinIO Console (port 9001).
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-your-minio-access-key
MINIO_SECRET_KEY=replace-with-your-minio-secret-key
MINIO_BUCKET=minio-server-testing

# When using compose.worker.yaml, disable the worker inside Next.js.
# SHEET_SYNC_MODE=external
# Optional Docker-only service addresses (macOS defaults):
# WORKER_POSTGRES_HOST=host.docker.internal
# WORKER_WAHA_API_URL=http://host.docker.internal:3000
